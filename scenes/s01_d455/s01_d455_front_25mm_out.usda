#usda 1.0
(
    metersPerUnit = 1
    subLayers = [
        @s01_d455_front_centered.usda@
    ]
    upAxis = "Z"
)

over "World"
{
    over "Nova_Carter_ROS"
    {
        over "chassis_link"
        {
            over "sensors"
            {
                over "echo_d455_front"
                {
                    double3 xformOp:translate = (0.1253, -0.000002, 0.3459)
                }
            }
        }
    }
}
