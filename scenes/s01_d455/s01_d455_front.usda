#usda 1.0
(
    metersPerUnit = 1
    subLayers = [
        @../full_warehouse/main_robot_ros.usd@
    ]
    upAxis = "Z"
)

over "World"
{
    over "Nova_Carter_ROS"
    {
        over "chassis_link"
        {
            over "sensors"
            {
                def Xform "echo_d455_front" (
                    prepend references = @https://omniverse-content-production.s3-us-west-2.amazonaws.com/Assets/Isaac/6.2/Isaac/Sensors/Intel/RealSense/rsd455.usd@</Root>
                )
                {
                    double3 xformOp:translate = (0.0993, 0, 0.3334)
                    uniform token[] xformOpOrder = ["xformOp:translate"]

                    over "RSD455"
                    {
                        bool physics:rigidBodyEnabled = 0
                    }
                }
            }
        }
    }
}
