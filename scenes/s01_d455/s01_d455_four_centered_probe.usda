#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Z"
    subLayers = [
        @s01_d455_four_mount_probe.usda@
    ]
)

over "World"
{
    over "Nova_Carter_ROS"
    {
        over "chassis_link"
        {
            over "sensors"
            {
                over "echo_d455_left"
                {
                    double3 xformOp:translate = (-0.2317, 0.171, 0.3439)
                }

                over "echo_d455_right"
                {
                    double3 xformOp:translate = (-0.2317, -0.171, 0.3439)
                }
            }
        }
    }
}
